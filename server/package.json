{
  "name": "@datadesk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DataDesk API (Fastify) and background validation worker",
  "scripts": {
    "dev": "node --env-file=../.env --watch --import tsx src/api.ts",
    "dev:worker": "node --env-file=../.env --watch --import tsx src/worker.ts",
    "build": "node build.mjs",
    "start": "node --enable-source-maps dist/api.js",
    "start:worker": "node --enable-source-maps dist/worker.js",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@datadesk/shared": "0.1.0",
    "@fastify/cookie": "^11.1.5",
    "@node-rs/argon2": "^2.2.1",
    "fastify": "^5.2.1",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.13.1",
    "re2-wasm": "^1.0.2",
    "zod": "^3.24.1",
    "papaparse": "^5.4.1",
    "@fastify/multipart": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "@types/papaparse": "^5.3.15"
  }
}

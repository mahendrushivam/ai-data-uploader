# Copy to .env (git-ignored) and set a password. Used by docker-compose.yml and, later, by the API.
POSTGRES_USER=datadesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=datadesk
POSTGRES_PORT=5432
# For tools running on your machine (API in dev, dbmate CLI):
DATABASE_URL=postgres://datadesk:change-me@localhost:5432/datadesk?sslmode=disable
# App (optional overrides)
WEB_PORT=8000
# The session cookie is Secure by default. Local Docker runs on plain http://localhost, so turn it off
# here; leave it true anywhere the app is served over HTTPS.
COOKIE_SECURE=false
MAX_FILE_BYTES=5242880
MAX_ROWS=20000
